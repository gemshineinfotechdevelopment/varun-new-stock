  "description": "Backend API Server for Varun Trade Stock Maintenance & Inventory System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node-dev --transpile-only seedData.ts",
    "test:flow": "ts-node --transpile-only testStockFlow.ts"
